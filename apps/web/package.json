{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Nuxt UI editor template — a Notion-like WYSIWYG editor with AI completions and image uploads — on Cloudflare Workers, R2 and Workers AI.",
