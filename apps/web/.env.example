# Copy to .dev.vars for `pnpm preview` (wrangler dev), or to .env for
# `pnpm dev`. On stage and prod AI_GATEWAY_API_KEY is the product's Orun
# secret of the same name, which the deploy sets on the Worker (README). Every
# one is optional.

# The Vercel AI Gateway's key. Unset, every completion and rewrite runs on
# Workers AI through the Worker's AI binding; set, they run on the template's
# own model through the gateway.
AI_GATEWAY_API_KEY=

# Real-time collaboration (optional, off): a PartyKit host
# (your-project.username.partykit.dev). Unset, the editor works standalone.
NUXT_PUBLIC_PARTYKIT_HOST=
